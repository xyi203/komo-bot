          "legendFormat": "{{komo_run_outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run 失败率",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "失败 = outcome 不是 completed/succeeded/ok/cancelled",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(komo_run_duration_count{komo_run_outcome!~\"completed|succeeded|ok|cancelled\"}[$__rate_interval])) / sum(rate(komo_run_duration_count[$__rate_interval]))",
          "legendFormat": "失败占比"
        }
      ]
    },
