{
  "uid": "komo-overview",
  "title": "komo 总览",
  "tags": [
    "komo"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "模型",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Token 速率（按用途 / 类型）",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "tokens/s",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (komo_llm_role, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\"}[$__rate_interval]))",
          "legendFormat": "{{komo_llm_role}} / {{gen_ai_token_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token 速率（按模型）",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "tokens/s",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_token_usage_sum{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "缓存命中率（cache_read / input）",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "分母只算 input；若 provider 的 input 不含缓存部分，该值可能超过 100%",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_token_usage_sum{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\",gen_ai_token_type=\"cache_read\"}[$__rate_interval])) / sum by (gen_ai_request_model) (rate(gen_ai_client_token_usage_sum{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\",gen_ai_token_type=\"input\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "错误率（按模型）",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_operation_duration_count{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\",error_type!=\"\"}[$__rate_interval])) / sum by (gen_ai_request_model) (rate(gen_ai_client_operation_duration_count{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "模型延迟 p50 / p95（按模型）",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le,gen_ai_request_model) (rate(gen_ai_client_operation_duration_bucket{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\"}[$__rate_interval])))",
          "legendFormat": "p50 {{gen_ai_request_model}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le,gen_ai_request_model) (rate(gen_ai_client_operation_duration_bucket{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\"}[$__rate_interval])))",
          "legendFormat": "p95 {{gen_ai_request_model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "模型调用速率（按用途 / 是否出错）",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (komo_llm_role, error_type) (rate(gen_ai_client_operation_duration_count{gen_ai_request_model=~\"$model\",komo_llm_role=~\"$role\"}[$__rate_interval]))",
          "legendFormat": "{{komo_llm_role}} {{error_type}}"
        }
      ]
    },
    {
      "type": "row",
