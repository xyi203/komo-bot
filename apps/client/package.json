{
  "name": "@komo/client",
  "version": "0.0.0",
  "private": true,
  "description": "komo 网页壳：TanStack Start（SPA 模式）构建出纯静态文件，由 Gateway 同源托管（docs/clients.md D1、D5）。",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && vite build",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsc --noEmit",
    "lint": "node scripts/lint-i18n.mjs && eslint ."
  },
  "dependencies": {
    "@komo/api": "workspace:*",
    "@komo/protocol": "workspace:*",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.105.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.29.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
